# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Every key the application reads is listed here. See src/portfolio/core/settings.py.

# --- required -----------------------------------------------------------------
# Async SQLAlchemy URL for the Supabase-hosted Postgres instance.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- portfolio ----------------------------------------------------------------
BASE_CURRENCY=GBP
# UK tax year starts 6 April.
TAX_YEAR_START_MONTH=4
TAX_YEAR_START_DAY=6

# --- observability ------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# --- price / news providers ---------------------------------------------------
# Leave a key blank to leave that provider unwired. Daily quotas are the
# per-provider call budget the quota ledger enforces; defaults follow the
# free-tier table in CLAUDE.md.
TWELVEDATA_API_KEY=
TWELVEDATA_DAILY_QUOTA=800

FINNHUB_API_KEY=
FINNHUB_DAILY_QUOTA=5000

ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_QUOTA=25

TIINGO_API_KEY=
TIINGO_DAILY_QUOTA=50

FMP_API_KEY=
FMP_DAILY_QUOTA=250

EODHD_API_KEY=
EODHD_DAILY_QUOTA=20
